---
import { ChevronLeft, ChevronRight, X } from "@lucide/astro";
import type { BoardGame } from "@/lib/board-games";

interface Props {
  game: BoardGame;
  id: string;
  titleId: string;
}

const { game, id, titleId } = Astro.props;
const initialImage = game.gallery[0];
---

<dialog
  class="gallery-dialog"
  id={id}
  aria-labelledby={titleId}
  data-gallery-dialog
>
  <h2 class="visually-hidden" id={titleId}>{game.name} gallery</h2>
  <button
    class="gallery-close"
    type="button"
    aria-label="Close gallery"
    data-gallery-close
  >
    <X size={22} aria-hidden="true" />
  </button>

  <div class="gallery-viewer">
    <button
      class="gallery-arrow"
      type="button"
      aria-label="Previous image"
      data-gallery-previous
    >
      <ChevronLeft size={28} aria-hidden="true" />
    </button>
    <img
      class="gallery-image"
      src={initialImage.url}
      alt={initialImage.description}
      width="1200"
      height="800"
      data-gallery-image
    />
    <button
      class="gallery-arrow"
      type="button"
      aria-label="Next image"
      data-gallery-next
    >
      <ChevronRight size={28} aria-hidden="true" />
    </button>
  </div>

  <p class="gallery-caption" data-gallery-caption>
    {initialImage.description}
  </p>

  <div class="gallery-thumbnails" aria-label="Gallery images">
    {
      game.gallery.map((image, imageIndex) => (
        <button
          class="gallery-thumbnail"
          type="button"
          aria-label={`View image ${imageIndex + 1}: ${image.description}`}
          aria-current={imageIndex === 0 ? "true" : "false"}
          data-gallery-thumbnail
          data-image-url={image.url}
          data-image-description={image.description}
        >
          <img
            src={image.url}
            alt=""
            width="120"
            height="80"
            loading="lazy"
          />
        </button>
      ))
    }
  </div>
</dialog>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gallery-dialog {
    width: min(72rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100% - 2rem);
    padding: 1rem;
    overflow: auto;
    border: 1px solid #475569;
    border-radius: 0.75rem;
    background: #071a3d;
    color: white;
  }

  .gallery-dialog::backdrop {
    background: rgb(0 0 0 / 80%);
  }

  .gallery-close {
    display: grid;
    place-items: center;
    margin: 0 0 0.75rem auto;
    padding: 0.45rem;
    border: 1px solid #64748b;
    border-radius: 50%;
    background: #0f254d;
    color: white;
    cursor: pointer;
  }

  .gallery-viewer {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
  }

  .gallery-image {
    width: 100%;
    max-height: 65vh;
    object-fit: contain;
    background: #020617;
  }

  .gallery-arrow {
    display: grid;
    place-items: center;
    padding: 0.5rem;
    border: 1px solid #64748b;
    border-radius: 50%;
    background: #0f254d;
    color: white;
    cursor: pointer;
  }

  .gallery-caption {
    margin: 0.75rem 3.5rem;
    color: #cbd5e1;
    text-align: center;
  }

  .gallery-thumbnails {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.25rem;
  }

  .gallery-thumbnail {
    flex: 0 0 auto;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: 0.35rem;
    background: transparent;
    cursor: pointer;
    opacity: 0.65;
  }

  .gallery-thumbnail[aria-current="true"] {
    border-color: #ffff55;
    opacity: 1;
  }

  .gallery-thumbnail img {
    display: block;
    width: 6rem;
    height: 4rem;
    object-fit: cover;
  }

  @container game-list (width < 39rem) {
    .gallery-dialog {
      width: calc(100% - 1rem);
      max-height: calc(100% - 1rem);
      padding: 0.75rem;
    }

    .gallery-viewer {
      gap: 0.35rem;
    }

    .gallery-arrow {
      padding: 0.3rem;
    }

    .gallery-caption {
      margin-inline: 0;
    }
  }
</style>
