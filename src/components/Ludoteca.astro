---
import GameShelf from "@/components/GameShelf.astro";
import { boardGames } from "@/lib/board-games";
---

<section class="cabinet" aria-label="Ludoteca">
  <span class="cabinet-crown" aria-hidden="true"></span>
  <ol class="game-list">
    {
      boardGames.map((game, index) => (
        <GameShelf game={game} index={index} />
      ))
    }
  </ol>
  <span class="cabinet-base" aria-hidden="true"></span>
</section>

<script>
  import "@/scripts/board-game-gallery";
</script>

<style>
  .cabinet {
    position: relative;
    padding: 2rem 2.1rem 2.5rem;
    border: 1px solid #9b6742;
    border-radius: 0.3rem;
    background:
      repeating-linear-gradient(
        88deg,
        transparent 0,
        transparent 3.5rem,
        rgb(52 26 12 / 18%) 3.6rem,
        transparent 3.75rem
      ),
      linear-gradient(
        90deg,
        #4b2b1b,
        #80502f 8%,
        #684025 50%,
        #80502f 92%,
        #4b2b1b
      );
    box-shadow:
      0 1.6rem 2.5rem rgb(0 0 0 / 42%),
      inset 0.3rem 0 0 rgb(255 223 176 / 11%),
      inset -0.3rem 0 0 rgb(0 0 0 / 24%);
  }

  .cabinet::before,
  .cabinet::after {
    position: absolute;
    z-index: 2;
    top: 1.35rem;
    bottom: 1.6rem;
    width: 1.4rem;
    background:
      linear-gradient(90deg, rgb(255 255 255 / 7%), transparent 35%),
      linear-gradient(90deg, #754628, #4c2a19);
    box-shadow: 0.3rem 0 0.6rem rgb(0 0 0 / 28%);
    content: "";
    pointer-events: none;
  }

  .cabinet::before {
    left: 0.65rem;
  }

  .cabinet::after {
    right: 0.65rem;
    transform: scaleX(-1);
  }

  .cabinet-crown,
  .cabinet-base {
    position: absolute;
    z-index: 4;
    right: -0.8rem;
    left: -0.8rem;
    height: 1.35rem;
    border: 1px solid rgb(255 224 180 / 20%);
    background:
      repeating-linear-gradient(
        2deg,
        transparent 0,
        transparent 2.5rem,
        rgb(45 20 10 / 20%) 2.6rem,
        transparent 2.75rem
      ),
      linear-gradient(180deg, #9a6038, #5c341e);
    box-shadow: 0 0.6rem 1rem rgb(0 0 0 / 35%);
    pointer-events: none;
  }

  .cabinet-crown {
    top: -0.55rem;
  }

  .cabinet-base {
    bottom: -0.65rem;
  }

  .game-list {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    overflow: visible;
    list-style: none;
    box-shadow: inset 0 0 1.5rem rgb(0 0 0 / 65%);
  }

  @media (max-width: 700px) {
    .cabinet {
      padding: 1.5rem 1rem 2rem;
    }

    .cabinet::before,
    .cabinet::after {
      width: 0.75rem;
    }

    .cabinet::before {
      left: 0.2rem;
    }

    .cabinet::after {
      right: 0.2rem;
    }

    .cabinet-crown,
    .cabinet-base {
      right: -0.2rem;
      left: -0.2rem;
    }
  }
</style>
