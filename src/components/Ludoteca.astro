---
import GameShelf from "@/components/GameShelf.astro";
import { boardGames } from "@/lib/board-games";
import woodWalnutA from "@assets/images/wood-walnut-a.webp?url";
import woodWalnutB from "@assets/images/wood-walnut-b.webp?url";
import woodWalnutC from "@assets/images/wood-walnut-c.webp?url";
import woodWalnutVertical from "@assets/images/wood-walnut-vertical.webp?url";
---

<section
  class="cabinet"
  aria-label="Ludoteca"
  style={`--wood-a: url("${woodWalnutA}"); --wood-b: url("${woodWalnutB}"); --wood-c: url("${woodWalnutC}"); --wood-vertical: url("${woodWalnutVertical}");`}
>
  <span class="cabinet-top-surface" aria-hidden="true"></span>
  <span class="cabinet-crown" aria-hidden="true"></span>
  <span class="cabinet-pediment" aria-hidden="true"></span>
  <span class="cabinet-trim cabinet-trim-left" aria-hidden="true"></span>
  <span class="cabinet-trim cabinet-trim-right" aria-hidden="true"></span>
  <ol class="game-list">
    {
      boardGames.map((game, index) => (
        <GameShelf game={game} index={index} />
      ))
    }
  </ol>
  <span class="cabinet-base" aria-hidden="true"></span>
</section>

<script>
  import "@/scripts/board-game-gallery";
</script>

<style>
  /* Shared cabinet geometry and outer frame */
  .cabinet {
    --frame-width: clamp(1.15rem, 2.8vw, 1.8rem);
    --cabinet-molding-overhang: calc(var(--frame-width) * -0.55);
    --cabinet-top-joint: 1.35rem;
    --cabinet-bottom-joint: 1.3rem;
    --cabinet-top-depth: clamp(1.2rem, 2.5vw, 1.8rem);
    --cabinet-top-inset: clamp(1.4rem, 4vw, 2.5rem);
    --cabinet-crown-radius: 0.5rem;
    --shelf-fascia-height: 1.35rem;
    --wood-horizontal-size: 48rem 16rem;
    --wood-vertical-size: 16rem 48rem;

    position: relative;
    inline-size: 100%;
    min-inline-size: 0;

    padding: var(--cabinet-top-joint) var(--frame-width)
      var(--cabinet-bottom-joint);
    border: 1px solid #5c3926;
    border-radius: 0.3rem;
    background: #17100c;
    box-shadow:
      0 1.6rem 2.5rem rgb(0 0 0 / 42%),
      inset 0.15rem 0 0 rgb(255 223 176 / 8%),
      inset -0.15rem 0 0 rgb(0 0 0 / 28%);
  }

  .cabinet::before,
  .cabinet::after {
    position: absolute;
    z-index: 2;
    top: var(--cabinet-top-joint);
    bottom: 1.45rem;
    width: var(--frame-width);
    background:
      linear-gradient(
        90deg,
        rgb(255 244 220 / 20%),
        transparent 18% 70%,
        rgb(21 9 5 / 42%)
      ),
      linear-gradient(105deg, transparent 35%, rgb(255 236 205 / 9%), transparent 66%),
      var(--wood-vertical);
    background-position: center, center, center top;
    background-size: 100% 100%, 100% 100%, var(--wood-vertical-size);
    box-shadow:
      0.3rem 0 0.7rem rgb(0 0 0 / 35%),
      inset -1px 0 rgb(26 11 6 / 65%);
    content: "";
    pointer-events: none;
  }

  .cabinet::before {
    left: 0;
  }

  .cabinet::after {
    right: 0;
    transform: scaleX(-1);
  }

  /* Visible top plane */
  .cabinet-top-surface {
    position: absolute;
    z-index: 2;
    top: calc(-0.65rem - var(--cabinet-top-depth));
    right: var(--cabinet-molding-overhang);
    left: var(--cabinet-molding-overhang);
    height: var(--cabinet-top-depth);
    border-top: 1px solid rgb(255 232 196 / 18%);
    background:
      linear-gradient(
        90deg,
        rgb(13 6 3 / 30%),
        transparent 10% 90%,
        rgb(13 6 3 / 32%)
      ),
      linear-gradient(
        180deg,
        rgb(45 24 14 / 22%),
        rgb(255 237 207 / 18%)
      ),
      var(--wood-a);
    background-position: center, center, 12% 45%;
    background-size: 100% 100%, 100% 100%, var(--wood-horizontal-size);
    clip-path: polygon(
      var(--cabinet-top-inset) 0,
      calc(100% - var(--cabinet-top-inset)) 0,
      calc(100% - var(--cabinet-crown-radius)) 100%,
      var(--cabinet-crown-radius) 100%
    );
    box-shadow: inset 0 1px rgb(255 245 225 / 14%);
    pointer-events: none;
  }

  /* Horizontal crown and base molding */
  .cabinet-crown,
  .cabinet-base {
    position: absolute;
    z-index: 4;
    right: var(--cabinet-molding-overhang);
    left: var(--cabinet-molding-overhang);
    height: 2rem;
    border: 1px solid rgb(255 224 180 / 18%);
    background:
      linear-gradient(
        180deg,
        rgb(255 239 211 / 18%),
        transparent 24% 62%,
        rgb(23 10 5 / 42%)
      ),
      linear-gradient(105deg, transparent 30%, rgb(255 239 215 / 8%), transparent 70%),
      var(--wood-a);
    background-position: center, center, 12% 48%;
    background-size: 100% 100%, 100% 100%, var(--wood-horizontal-size);
    box-shadow:
      0 0.6rem 1rem rgb(0 0 0 / 35%),
      inset 0 1px rgb(255 238 207 / 16%);
    pointer-events: none;
  }

  .cabinet-crown::before,
  .cabinet-crown::after,
  .cabinet-base::before,
  .cabinet-base::after {
    position: absolute;
    right: 0.6rem;
    left: 0.6rem;
    height: 0.11rem;
    border-radius: 999px;
    background: rgb(33 16 9 / 42%);
    content: "";
    box-shadow:
      inset 0 1px rgb(20 8 4 / 70%),
      0 1px rgb(255 231 194 / 12%);
  }

  .cabinet-crown::before,
  .cabinet-base::before {
    top: 0.28rem;
  }

  .cabinet-crown::after,
  .cabinet-base::after {
    bottom: 0.28rem;
    height: 0.08rem;
    opacity: 0.72;
  }

  .cabinet-crown {
    top: -0.65rem;
    border-radius: var(--cabinet-crown-radius) var(--cabinet-crown-radius)
      0.16rem 0.16rem;
  }

  .cabinet-base {
    bottom: -0.7rem;
    border-radius: 0.18rem 0.18rem 0.65rem 0.65rem;
    background-image:
      linear-gradient(
        180deg,
        rgb(255 239 211 / 14%),
        transparent 25% 58%,
        rgb(23 10 5 / 48%)
      ),
      linear-gradient(105deg, transparent 35%, rgb(255 239 215 / 7%), transparent 68%),
      var(--wood-b);
  }

  /* Curved crown ornament */
  .cabinet-pediment {
    position: absolute;
    z-index: 3;
    top: -2.1rem;
    left: 50%;
    width: min(38%, 20rem);
    height: 3rem;
    border: 1px solid rgb(255 224 180 / 18%);
    background:
      radial-gradient(ellipse at 50% 82%, rgb(255 231 193 / 17%), transparent 52%),
      linear-gradient(180deg, rgb(255 239 211 / 16%), transparent 38%, rgb(23 10 5 / 38%)),
      var(--wood-a);
    background-position: center, center, 45% 48%;
    background-size: 100% 100%, 100% 100%, var(--wood-horizontal-size);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    filter: drop-shadow(0 0.45rem 0.35rem rgb(0 0 0 / 38%));
    transform: translateX(-50%);
    pointer-events: none;
  }

  .cabinet-pediment::before {
    position: absolute;
    top: 0.9rem;
    left: 50%;
    width: 1rem;
    aspect-ratio: 1;
    border: 0.16rem solid rgb(54 28 16 / 72%);
    border-radius: 50%;
    background: radial-gradient(circle at 38% 32%, #b88358, #57321e 62%, #2c160c);
    box-shadow:
      0 0 0 1px rgb(255 226 188 / 22%),
      0 0.18rem 0.25rem rgb(0 0 0 / 48%);
    content: "";
    transform: translateX(-50%);
  }

  .cabinet-pediment::after {
    position: absolute;
    top: 0.38rem;
    left: 50%;
    width: 68%;
    height: 1.45rem;
    border-top: 0.2rem solid rgb(45 23 13 / 68%);
    border-radius: 50% 50% 0 0 / 100% 100% 0 0;
    box-shadow: 0 -1px rgb(255 231 196 / 18%);
    content: "";
    transform: translateX(-50%);
  }

  /* Raised vertical trim */
  .cabinet-trim {
    position: absolute;
    z-index: 3;
    top: var(--cabinet-top-joint);
    bottom: 1.9rem;
    width: clamp(0.42rem, 0.9vw, 0.62rem);
    border-radius: 999px;
    background:
      linear-gradient(
        90deg,
        rgb(255 243 221 / 30%),
        rgb(116 70 42 / 54%) 38%,
        rgb(28 12 6 / 72%)
      ),
      var(--wood-vertical);
    background-position: center, center top;
    background-size: 100% 100%, var(--wood-vertical-size);
    box-shadow:
      0.12rem 0 0.2rem rgb(0 0 0 / 42%),
      -1px 0 rgb(255 230 193 / 12%);
    pointer-events: none;
  }

  .cabinet-trim::after {
    position: absolute;
    left: 50%;
    width: calc(100% + 0.72rem);
    height: 0.82rem;
    border: 1px solid rgb(255 229 192 / 14%);
    border-radius: 22% 22% 48% 48%;
    background:
      linear-gradient(180deg, rgb(255 236 204 / 19%), transparent 38%, rgb(25 11 6 / 43%)),
      var(--wood-a);
    background-position: center, 15% 45%;
    background-size: 100% 100%, var(--wood-horizontal-size);
    box-shadow: 0 0.18rem 0.28rem rgb(0 0 0 / 38%);
    content: "";
    transform: translateX(-50%);
  }

  .cabinet-trim::after {
    bottom: -0.36rem;
  }

  .cabinet-trim-left {
    left: calc(var(--frame-width) * 0.36);
  }

  .cabinet-trim-right {
    right: calc(var(--frame-width) * 0.36);
    transform: scaleX(-1);
  }

  /* Shelf compartments */
  .game-list {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: 0;
    overflow: visible;
    list-style: none;
    background: #17100c;
    box-shadow:
      inset 0.55rem 0 0.9rem rgb(0 0 0 / 45%),
      inset -0.55rem 0 0.9rem rgb(0 0 0 / 45%);
    container: game-list / inline-size;
    inline-size: 100%;
    min-inline-size: 0;
  }

  @media (max-width: 700px) {
    .cabinet {
      --cabinet-molding-overhang: -0.2rem;

      padding-top: var(--cabinet-top-joint);
      padding-bottom: var(--cabinet-bottom-joint);
    }

    .cabinet-pediment {
      top: -1.55rem;
      width: 58%;
      height: 2.25rem;
    }
  }
</style>
