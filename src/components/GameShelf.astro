---
import { Clock, ExternalLink, Users } from "@lucide/astro";
import GameBox from "@/components/GameBox.astro";
import GalleryDialog from "@/components/GalleryDialog.astro";
import type { BoardGame } from "@/lib/board-games";

interface Props {
  game: BoardGame;
  index: number;
}

const { game, index } = Astro.props;
const galleryId = `gallery-${index}`;
const galleryTitleId = `gallery-title-${index}`;
const restingTilt = index % 2 === 0 ? -0.7 : 0.55;
---

<li class="game-shelf">
  <span class="shelf-side shelf-side-left" aria-hidden="true"></span>
  <span class="shelf-side shelf-side-right" aria-hidden="true"></span>

  <GameBox game={game} galleryId={galleryId} restingTilt={restingTilt} />

  <div class="game-details">
    <h2>{game.name}</h2>
    <p>{game.description}</p>
    <div class="game-facts">
      <span class="game-fact">
        <Users size={18} aria-hidden="true" />
        <span>
          {game.playerCount.supported}
          {
            game.playerCount.recommended &&
              ` (Best: ${game.playerCount.recommended})`
          }
        </span>
      </span>
      <span class="game-fact">
        <Clock size={18} aria-hidden="true" />
        <span>{game.time}</span>
      </span>
    </div>
    <a
      class="bgg-link"
      href={game.bggUrl}
      target="_blank"
      rel="noreferrer"
    >
      BGG
      <ExternalLink size={16} aria-hidden="true" />
    </a>
  </div>

  <span class="shelf-board" aria-hidden="true"></span>

  <GalleryDialog game={game} id={galleryId} titleId={galleryTitleId} />
</li>

<style>
  /* Compartment layout, backing texture, and ambient shadows */
  .game-shelf {
    --shelf-wood: var(--wood-a);
    --grain-offset: 8%;
    --shelf-depth: clamp(2.4rem, 5.5cqw, 3.5rem);
    --shelf-inset: clamp(2rem, 5cqw, 3.15rem);
    --shelf-content-clearance: 2.15rem;

    position: relative;
    display: grid;
    grid-template-columns: clamp(15rem, 30cqw, 17rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3cqw, 1.75rem);
    align-items: center;
    min-height: 19rem;
    padding: 1.25rem clamp(2.2rem, 5.2cqw, 3.35rem)
      calc(var(--shelf-depth) + var(--shelf-content-clearance));
    overflow: visible;
    background:
      radial-gradient(
        ellipse 13rem 9rem at 24% 57%,
        rgb(0 0 0 / 40%),
        rgb(0 0 0 / 14%) 46%,
        transparent 72%
      ),
      linear-gradient(
        180deg,
        rgb(0 0 0 / 44%),
        transparent 2.4rem 78%,
        rgb(0 0 0 / 12%)
      ),
      linear-gradient(
        90deg,
        rgb(0 0 0 / 46%),
        transparent 11% 89%,
        rgb(0 0 0 / 48%)
      ),
      radial-gradient(ellipse at 20% 68%, rgb(185 120 72 / 12%), transparent 38%),
      linear-gradient(rgb(25 18 14 / 76%), rgb(25 18 14 / 76%)),
      var(--shelf-wood);
    background-position:
      center,
      center,
      center,
      center,
      center,
      var(--grain-offset) 48%;
    background-size:
      100% 100%,
      100% 100%,
      100% 100%,
      100% 100%,
      100% 100%,
      var(--wood-horizontal-size);
    box-shadow: inset 0 -1rem 1.4rem rgb(0 0 0 / 28%);
    isolation: isolate;
  }

  .game-shelf:nth-child(3n + 2) {
    --shelf-wood: var(--wood-b);
    --grain-offset: 43%;
  }

  .game-shelf:nth-child(3n) {
    --shelf-wood: var(--wood-c);
    --grain-offset: 71%;
  }

  /* Recessed vertical side planes */
  .shelf-side {
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: var(--shelf-fascia-height);
    width: var(--shelf-inset);
    background:
      linear-gradient(
        90deg,
        rgb(255 235 202 / 8%),
        transparent 28% 52%,
        rgb(14 6 3 / 76%)
      ),
      var(--wood-vertical);
    background-position: center, center top;
    background-size: 100% 100%, var(--wood-vertical-size);
    pointer-events: none;
  }

  .shelf-side-left {
    left: 0;
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - var(--shelf-depth)),
      0 100%
    );
    box-shadow:
      inset -1px 0 rgb(255 230 193 / 8%),
      0.5rem 0 0.9rem rgb(0 0 0 / 38%);
  }

  .shelf-side-right {
    right: 0;
    background-image:
      linear-gradient(
        90deg,
        rgb(14 6 3 / 76%),
        transparent 48% 72%,
        rgb(255 235 202 / 8%)
      ),
      var(--wood-vertical);
    clip-path: polygon(
      0 0,
      100% 0,
      100% 100%,
      0 calc(100% - var(--shelf-depth))
    );
    box-shadow:
      inset 1px 0 rgb(255 230 193 / 8%),
      -0.5rem 0 0.9rem rgb(0 0 0 / 38%);
  }

  /* Shelf fascia and top surface */
  .shelf-board {
    position: absolute;
    z-index: 3;
    right: calc(-1 * var(--frame-width));
    bottom: 0;
    left: calc(-1 * var(--frame-width));
    height: var(--shelf-fascia-height);
    border-top: 1px solid rgb(255 232 196 / 24%);
    border-bottom: 1px solid rgb(24 10 5 / 75%);
    background:
      linear-gradient(
        180deg,
        rgb(255 238 210 / 17%),
        transparent 22% 58%,
        rgb(20 8 4 / 46%)
      ),
      linear-gradient(105deg, transparent 32%, rgb(255 239 218 / 8%), transparent 68%),
      var(--shelf-wood);
    background-position: center, center, var(--grain-offset) 52%;
    background-size: 100% 100%, 100% 100%, var(--wood-horizontal-size);
    box-shadow:
      0 0.45rem 0.7rem rgb(0 0 0 / 42%),
      inset 0 1px rgb(255 241 216 / 12%);
    pointer-events: none;
  }

  .shelf-board::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: var(--shelf-depth);
    background:
      linear-gradient(
        90deg,
        rgb(13 6 3 / 38%),
        transparent 12% 88%,
        rgb(13 6 3 / 40%)
      ),
      radial-gradient(
        ellipse 12rem 4rem at 24% 8%,
        rgb(0 0 0 / 42%),
        rgb(0 0 0 / 12%) 48%,
        transparent 74%
      ),
      linear-gradient(180deg, rgb(45 24 14 / 20%), rgb(255 237 207 / 20%)),
      var(--shelf-wood);
    background-position: center, center, center, var(--grain-offset) 45%;
    background-size:
      100% 100%,
      100% 100%,
      100% 100%,
      var(--wood-horizontal-size);
    clip-path: polygon(
      calc(var(--frame-width) + var(--shelf-inset)) 0,
      calc(100% - var(--frame-width) - var(--shelf-inset)) 0,
      calc(100% - var(--frame-width)) 100%,
      var(--frame-width) 100%
    );
    content: "";
    box-shadow: inset 0 1px rgb(255 245 225 / 17%);
  }

  .shelf-board::after {
    position: absolute;
    top: 0.48rem;
    right: 2.5%;
    left: 2.5%;
    height: 0.16rem;
    border-top: 1px solid rgb(255 231 194 / 14%);
    border-bottom: 1px solid rgb(21 8 4 / 68%);
    border-radius: 999px;
    background: rgb(47 23 12 / 28%);
    content: "";
    box-shadow: 0 1px 0 rgb(255 235 199 / 7%);
  }

  /* Game information */
  .game-details {
    position: relative;
    z-index: 1;
    max-width: 34rem;
    padding-right: 1rem;
    text-shadow: 0 2px 3px rgb(0 0 0 / 70%);
  }

  .game-details h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    line-height: 1.1;
  }

  .game-details p {
    max-width: 48ch;
    margin: 0 0 1rem;
    color: #e7dfd7;
    line-height: 1.55;
  }

  .game-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.9rem;
    color: #d6ccc2;
    font-size: 0.9rem;
  }

  .game-fact,
  .bgg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .bgg-link {
    color: #ffff55;
    font-weight: 700;
  }

  /* Stacked layout */
  @container game-list (width < 39rem) {
    .game-shelf {
      grid-template-columns: 1fr;
      gap: 0;
      justify-items: center;
      min-height: 0;
      padding: 1.75rem clamp(2.15rem, 8cqw, 3rem)
        calc(var(--shelf-depth) + var(--shelf-content-clearance));
      contain-intrinsic-block-size: 32rem;
    }

    .game-details {
      width: min(100%, 28rem);
      padding: 0 0.5rem 1rem;
      text-align: center;
    }

    .game-details p {
      margin-inline: auto;
    }

    .game-facts {
      justify-content: center;
    }

  }
</style>
