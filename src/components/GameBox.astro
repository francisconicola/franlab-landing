---
import type { BoardGame } from "@/lib/board-games";

interface Props {
  game: BoardGame;
  galleryId: string;
  restingTilt?: number;
}

const { game, galleryId, restingTilt = 0 } = Astro.props;
const desktopScale = 0.4;
const mobileScale = 0.32;
const dimensions = game.box.dimensionsCm;
const scaleDimension = (centimeters: number, scale: number) =>
  Number((centimeters * scale).toFixed(3));

const boxWidth = scaleDimension(dimensions.width, desktopScale);
const boxHeight = scaleDimension(dimensions.height, desktopScale);
const boxDepth = scaleDimension(dimensions.depth, desktopScale);
const depthClearance = Number(
  Math.max(0, (boxDepth - 2) * 0.08).toFixed(3),
);

const mobileBoxWidth = scaleDimension(dimensions.width, mobileScale);
const mobileBoxHeight = scaleDimension(dimensions.height, mobileScale);
const mobileBoxDepth = scaleDimension(dimensions.depth, mobileScale);
const mobileDepthClearance = Number(
  Math.max(0, (mobileBoxDepth - 2) * 0.08).toFixed(3),
);
---

<div
  class="box-stage"
  style={`--box-color: ${game.box.color}; --box-width: ${boxWidth}rem; --box-height: ${boxHeight}rem; --box-depth: ${boxDepth}rem; --depth-clearance: ${depthClearance}rem; --mobile-box-width: ${mobileBoxWidth}rem; --mobile-box-height: ${mobileBoxHeight}rem; --mobile-box-depth: ${mobileBoxDepth}rem; --mobile-depth-clearance: ${mobileDepthClearance}rem; --resting-tilt: ${restingTilt}deg;`}
>
  <button
    class="box-scene"
    type="button"
    aria-label={`Open ${game.name} image gallery`}
    aria-controls={galleryId}
  >
    <span class="game-box">
      <span class="box-face box-front">
        <img
          src={game.box.coverUrl}
          alt={`Portada del juego de mesa ${game.name}.`}
          loading="lazy"
        />
      </span>
      <span class="box-face box-spine" aria-hidden="true"></span>
      <span class="box-face box-top" aria-hidden="true"></span>
    </span>
  </button>
</div>

<style>
  .box-stage {
    position: relative;
    align-self: end;
    display: grid;
    place-items: center;
    width: 15rem;
    height: calc(var(--box-height) + 2rem);
    perspective: 900px;
    perspective-origin: 48% 42%;
  }

  .box-scene {
    position: relative;
    z-index: 1;
    width: var(--box-width);
    height: var(--box-height);
    padding: 0;
    border: 0;
    outline: none;
    background: transparent;
    cursor: zoom-in;
    transform-style: preserve-3d;
  }

  .game-box {
    position: absolute;
    inset: 0;
    display: block;
    transform: translateY(calc(0rem - var(--depth-clearance))) rotateX(-5deg)
      rotateY(-24deg) rotateZ(var(--resting-tilt));
    transform-origin: center bottom;
    transform-style: preserve-3d;
    transition: transform 260ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .box-face {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 18%);
    backface-visibility: hidden;
  }

  .box-front {
    width: var(--box-width);
    height: var(--box-height);
    margin-top: calc(var(--box-height) / -2);
    margin-left: calc(var(--box-width) / -2);
    background: var(--box-color);
    box-shadow: inset 0 0 1.2rem rgb(255 255 255 / 7%);
    transform: translateZ(calc(var(--box-depth) / 2));
  }

  .box-front::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgb(255 255 255 / 18%),
      transparent 18%,
      transparent 75%,
      rgb(0 0 0 / 18%)
    );
    content: "";
    pointer-events: none;
  }

  .box-front img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .box-spine {
    width: var(--box-depth);
    height: var(--box-height);
    margin-top: calc(var(--box-height) / -2);
    margin-left: calc(var(--box-depth) / -2);
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--box-color), black 35%),
      var(--box-color)
    );
    transform: rotateY(90deg) translateZ(calc(var(--box-width) / 2));
  }

  .box-top {
    width: var(--box-width);
    height: var(--box-depth);
    margin-top: calc(var(--box-depth) / -2);
    margin-left: calc(var(--box-width) / -2);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--box-color), white 30%),
      color-mix(in srgb, var(--box-color), white 10%)
    );
    transform: rotateX(90deg) translateZ(calc(var(--box-height) / 2));
  }

  .box-scene:hover .game-box,
  .box-scene:focus-visible .game-box {
    transform: translateY(calc(-0.2rem - var(--depth-clearance)))
      translateZ(1.1rem) rotateX(-4deg) rotateY(-16deg) rotateZ(0deg);
  }

  .box-scene:focus-visible::after {
    position: absolute;
    z-index: 2;
    inset: -0.45rem;
    border: 3px solid #ffff55;
    border-radius: 0.25rem;
    content: "";
  }

  @media (prefers-reduced-motion: reduce) {
    .game-box {
      transition: none;
    }

    .box-scene:hover .game-box,
    .box-scene:focus-visible .game-box {
      transform: translateY(calc(0rem - var(--depth-clearance)))
        rotateX(-5deg) rotateY(-24deg) rotateZ(var(--resting-tilt));
    }
  }

  @media (min-width: 701px) {
    .box-stage {
      margin-bottom: 0.75rem;
    }
  }

  @media (max-width: 600px) {
    .box-stage {
      --box-width: var(--mobile-box-width);
      --box-height: var(--mobile-box-height);
      --box-depth: var(--mobile-box-depth);
      --depth-clearance: var(--mobile-depth-clearance);
      width: 12rem;
      height: calc(var(--box-height) + 1.5rem);
    }

    .game-box {
      transform: translateY(calc(0rem - var(--depth-clearance)))
        rotateX(-4deg) rotateY(-19deg) rotateZ(var(--resting-tilt));
    }
  }
</style>
