---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="franlab">
  <canvas class="terrain-background" id="terrain-background" aria-hidden="true"></canvas>

  <header class="title">
    <h1>franlab, a lab for things™</h1>
    <div class="splash" id="splash"></div>
  </header>
  <main>
    <div
      class="smile"
      id="smile"
      role="img"
      aria-label="Rotating face"
    ></div>
  </main>

  <script>
    import "../scripts/wireframe-terrain";

    const faceEmojis = ["🥸", "😎", "🤠", "🫪", "😂", "🤯", "🤢", "😵‍💫", "😴"];

    const splashPhrases = [
      "Parche is watching closely",
      "This page is self-service",
      "100% water-powered!",
      "You are being evaluated",
      "Happy Thursday!",
      "Free bitcoins tomorrow!",
      "SOHCAHTOA...",
      "Choose your champignon",
    ];

    function randomItem<T>(items: T[]) {
      return items[Math.floor(Math.random() * items.length)];
    }

    const smile = document.querySelector("#smile");
    const splash = document.querySelector("#splash");

    if (smile && splash) {
      smile.textContent = randomItem(faceEmojis);
      splash.textContent = randomItem(splashPhrases);
    }
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #0b0c0e;
  }

  .terrain-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    background: #0b0c0e;
    pointer-events: none;
  }

  .title,
  main {
    z-index: 1;
  }
</style>
