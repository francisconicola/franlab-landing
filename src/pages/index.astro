---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="franlab">
  <canvas class="terrain-background" id="terrain-background" aria-hidden="true"></canvas>

  <header class="title">
    <h1>franlab, a lab for things™</h1>
    <div class="splash" id="splash"></div>
  </header>
  <main>
    <div class="home-hub">
      <div
        class="smile"
        id="smile"
        role="img"
        aria-label="Rotating face"
      ></div>

      <nav class="portal-links" aria-label="Site sections">
        <a class="portal-button" href="/ludoteca">Ludoteca</a>
        <button class="portal-button" type="button" disabled>
          secret stuff
        </button>
        <button class="portal-button" type="button" disabled>
          secret stuff
        </button>
      </nav>
    </div>
  </main>

  <script>
    import "@/scripts/wireframe-terrain";

    const faceEmojis = ["🥸", "😎", "🤠", "🫪", "😂", "🤯", "🤢", "😵‍💫", "😴"];

    const splashPhrases = [
      "Parche is watching closely",
      "This page is self-service",
      "100% water-powered!",
      "You are being evaluated",
      "Happy Thursday!",
      "Free bitcoins tomorrow!",
      "SOHCAHTOA...",
      "Choose your champignon",
    ];

    function randomItem<T>(items: T[]) {
      return items[Math.floor(Math.random() * items.length)];
    }

    const smile = document.querySelector("#smile");
    const splash = document.querySelector("#splash");

    if (smile && splash) {
      smile.textContent = randomItem(faceEmojis);
      splash.textContent = randomItem(splashPhrases);
    }
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #0b0c0e;
  }

  .terrain-background {
    position: fixed;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    background: #0b0c0e;
    pointer-events: none;
  }

  .title,
  main {
    z-index: 1;
  }

  .home-hub {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
  }

  .portal-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    width: min(24rem, calc(100vw - 2rem));
  }

  .portal-button {
    position: relative;
    display: grid;
    min-width: 0;
    min-height: 2.35rem;
    place-items: center;
    padding: 0.5rem 0.4rem;
    border: 1px solid rgb(110 231 183 / 78%);
    border-radius: 0;
    background:
      linear-gradient(135deg, rgb(110 231 183 / 12%), transparent 45%),
      rgb(11 12 14 / 78%);
    box-shadow:
      inset 0 0 0.75rem rgb(110 231 183 / 5%),
      0 0 0.7rem rgb(110 231 183 / 9%);
    color: #a7f3d0;
    font: 700 0.72rem/1 monospace;
    letter-spacing: 0.04em;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
  }

  a.portal-button {
    transition:
      color 140ms ease,
      background-color 140ms ease,
      box-shadow 140ms ease,
      transform 140ms ease;
  }

  a.portal-button:hover,
  a.portal-button:focus-visible {
    background-color: rgb(110 231 183 / 12%);
    box-shadow:
      inset 0 0 0.9rem rgb(110 231 183 / 13%),
      0 0 1rem rgb(110 231 183 / 24%);
    color: #ecfdf5;
    outline: 1px solid #6ee7b7;
    outline-offset: 3px;
    transform: translateY(-2px);
  }

  button.portal-button:disabled {
    border-color: rgb(110 231 183 / 27%);
    box-shadow: none;
    color: rgb(167 243 208 / 35%);
    cursor: not-allowed;
  }
</style>
